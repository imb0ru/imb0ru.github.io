---
import type { MarkdownHeading } from 'astro';
import { t } from '../i18n/ui';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  toc.length > 0 && (
    <nav class="toc" aria-label={t('post.toc')}>
      <p class="eyebrow toc-title">{t('post.toc')}</p>
      <ul>
        {toc.map((h) => (
          <li class:list={['toc-item', `depth-${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc-title {
    margin-bottom: 0.8rem;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }
  .toc-item a {
    display: block;
    padding: 0.28rem 0 0.28rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--text-dim);
    font-size: 0.86rem;
    line-height: 1.4;
  }
  .toc-item.depth-3 a {
    padding-left: 1.8rem;
    font-size: 0.82rem;
  }
  .toc-item a:hover {
    color: var(--text);
    border-left-color: var(--accent-line);
    text-decoration: none;
  }
</style>

---
import type { Section } from '../../../consts';
import { SECTIONS } from '../../../consts';
import { getEntries } from '../../../lib/content';
import { t } from '../../../i18n/ui';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogStream from '../../../components/BlogStream.astro';

export function getStaticPaths() {
  return SECTIONS.map((section) => ({ params: { type: section }, props: { section } }));
}

const { section } = Astro.props as { section: Section };
const items = (await getEntries(section)).map((entry) => ({ section, entry }));

const groupBy = section === 'writeups' ? 'ctf' : section === 'challenges' ? 'event' : undefined;
---

<BaseLayout title={t(`type.${section}`)}>
  <BlogStream active={section} items={items} groupBy={groupBy} />
</BaseLayout>

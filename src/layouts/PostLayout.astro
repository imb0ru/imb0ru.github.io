---
import type { MarkdownHeading } from 'astro';
import type { Section } from '../consts';
import { withBase, formatDate } from '../lib/url';
import { t } from '../i18n/ui';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Difficulty from '../components/Difficulty.astro';
import Icon from '../components/Icon.astro';

interface Props {
  section: Section;
  title: string;
  description: string;
  data: Record<string, any>;
  headings: MarkdownHeading[];
  minutesRead?: number;
}
const { section, title, description, data, headings, minutesRead } = Astro.props;

const backUrl = withBase(`/blog/${section}`);
const published = new Date(data.pubDate);
const updated = data.updatedDate ? new Date(data.updatedDate) : undefined;
const tags: string[] = data.tags ?? [];

const headerKicker =
  section === 'writeups'
    ? data.ctf ?? data.category
    : section === 'challenges'
      ? data.event ?? data.category
      : section === 'research'
        ? data.venue
        : data.category;

type Row = { label: string; value: string; mono?: boolean };
const details: Row[] = [];
if (data.difficulty) details.push({ label: t('post.difficulty'), value: t(`difficulty.${data.difficulty}`) });
if (section === 'writeups' && data.ctf) details.push({ label: t('post.event'), value: data.ctf });
if (section === 'challenges' && data.event) details.push({ label: t('challenge.event'), value: data.event });
if (data.category) details.push({ label: t('post.category'), value: data.category });
if (section === 'challenges' && data.flagFormat)
  details.push({ label: t('challenge.flagFormat'), value: data.flagFormat, mono: true });
if (typeof data.solved === 'number') details.push({ label: 'Solves', value: String(data.solved) });
if (section === 'research' && data.venue) details.push({ label: t('research.venue'), value: data.venue });

type Action = { href: string; label: string; icon: string };
const actions: Action[] = [];
if (data.downloadUrl) actions.push({ href: data.downloadUrl, label: t('challenge.download'), icon: 'download' });
if (data.sourceUrl)
  actions.push({
    href: data.sourceUrl,
    label: t('challenge.source'),
    icon: String(data.sourceUrl).includes('github') ? 'github' : 'external',
  });
if (data.externalUrl) actions.push({ href: data.externalUrl, label: t('research.external'), icon: 'external' });
if (data.pdfUrl) actions.push({ href: data.pdfUrl, label: t('research.pdf'), icon: 'download' });

const resolveHref = (h: string) => (h.startsWith('http') ? h : withBase(h));
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  article={{
    publishedTime: published.toISOString(),
    modifiedTime: updated?.toISOString(),
    tags,
  }}
>
  <article class="post container">
    <a class="post-back" href={backUrl}>
      <Icon name="arrow-left" size={15} />
      {t('post.back', { section: t(`type.${section}`) })}
    </a>

    <header class="post-header">
      <div class="post-kickers">
        {headerKicker && <span class="post-kicker mono">{headerKicker}</span>}
        {data.difficulty && <Difficulty level={data.difficulty} />}
      </div>
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-desc lede">{description}</p>}
      <div class="post-meta">
        <span class="meta-item">
          <Icon name="calendar" size={15} />
          <time datetime={published.toISOString()}>{formatDate(published)}</time>
        </span>
        {
          minutesRead && (
            <span class="meta-item">
              <Icon name="clock" size={15} />
              {t('meta.minRead', { n: minutesRead })}
            </span>
          )
        }
        {updated && <span class="meta-item text-dim">{t('meta.updated', { date: formatDate(updated) })}</span>}
      </div>
    </header>

    <div class="post-body">
      <div class="post-content prose">
        <slot />
      </div>

      <aside class="post-aside">
        <div class="post-aside-sticky">
          {
            actions.length > 0 && (
              <div class="post-actions">
                {actions.map((a) => (
                  <a
                    class="btn"
                    href={resolveHref(a.href)}
                    {...(a.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                  >
                    <Icon name={a.icon} size={16} />
                    {a.label}
                  </a>
                ))}
              </div>
            )
          }
          {
            details.length > 0 && (
              <dl class="post-details">
                {details.map((row) => (
                  <div class="detail-row">
                    <dt>{row.label}</dt>
                    <dd class:list={{ mono: row.mono }}>{row.value}</dd>
                  </div>
                ))}
              </dl>
            )
          }
          {
            tags.length > 0 && (
              <div class="post-tags">
                <p class="eyebrow">{t('post.tags')}</p>
                <div class="tag-row">
                  {tags.map((tg) => (
                    <span class="tag">#{tg}</span>
                  ))}
                </div>
              </div>
            )
          }
          <div class="toc-wrap">
            <TableOfContents headings={headings} />
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
  }
  .post-back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-dim);
    margin-bottom: 1.6rem;
  }
  .post-back:hover {
    color: var(--text);
    text-decoration: none;
  }

  .post-header {
    max-width: 52rem;
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .post-kickers {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.9rem;
  }
  .post-kicker {
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .post-title {
    font-size: var(--fs-2xl);
    font-weight: 680;
    letter-spacing: -0.02em;
  }
  .post-desc {
    margin-top: 0.9rem;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 1.3rem;
    font-size: 0.84rem;
    color: var(--text-dim);
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .post-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: 3.2rem;
    align-items: start;
  }
  .post-content {
    max-width: none;
    min-width: 0;
  }
  .post-aside-sticky {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .post-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .post-actions .btn {
    width: 100%;
  }
  .post-details {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.1rem 1.2rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin: 0;
  }
  .detail-row dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-faint);
  }
  .detail-row dd {
    margin: 0.15rem 0 0;
    color: var(--text);
    font-size: 0.92rem;
  }
  .detail-row dd.mono {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
    word-break: break-all;
  }
  .post-tags .eyebrow {
    margin-bottom: 0.7rem;
  }

  @media (max-width: 980px) {
    .post-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .post-aside {
      order: -1;
    }
    .post-aside-sticky {
      position: static;
    }
    .toc-wrap {
      display: none;
    }
  }
</style>
